APP_NAME=Chirp Jobs
# development | production | demo
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_THEME=professional-blue
PORT=3000
SESSION_SECRET=change-me-in-production

DATA_PATH=storage/data.json

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@chirpjobs.local
MAIL_FROM_NAME=Chirp Jobs

JOB_DEFAULT_COMPANY_NAME=
JOB_DEFAULT_CONTACT_EMAIL=

SECURITY_LOGIN_MAX_ATTEMPTS=10
SECURITY_LOGIN_WINDOW_SECONDS=900
SECURITY_PIN_MAX_ATTEMPTS=8
SECURITY_PIN_WINDOW_SECONDS=900

# Theme options: professional-blue | indigo-teal | emerald-slate
